# Copy this file to .env.local for local development.
# Set the VITE_ variables in your hosting provider before a production build.
# Do not commit .env.local or put database/service-role secrets in a VITE_ variable.

# Optional local Vite-only fallback. It is not used by the hosted dashboard.
CHAOS_ADMIN_PASSPHRASE="change-this-local-only"

# Terminal unlock phrase. This opens the dashboard but is not the security boundary.
VITE_CHAOS_ADMIN_UNLOCK_PHRASE="change-this-unlock-phrase"

# Supabase browser configuration. The anon key is safe to expose only with RLS enabled.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ADMIN_USER_ID="your-supabase-auth-user-uuid"
VITE_SUPABASE_CONTENT_TABLE="website_content"
VITE_SUPABASE_CONTENT_ID="main"
VITE_SUPABASE_ASSET_BUCKET="website-assets"
